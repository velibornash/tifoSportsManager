<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.example</groupId>
    <artifactId>footballmanager</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Football Manager</name>
    <description>Simple Spring Boot football manager</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Disable release flag so Lombok annotation processor works (known issue
             with maven-compiler-plugin + Spring Boot parent).
             Source and target plus add-opens provide equivalent isolation. -->
        <maven.compiler.release></maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Spring Boot starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-security</artifactId>
            </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- REST API Testing (Backend/E2E) -->
        <!-- REST Assured for API testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JSON path for response parsing -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.8.0</version>
            <scope>test</scope>
        </dependency>

        <!-- UI Testing (Playwright) -->
        <!-- Playwright for browser automation -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.42.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Additional Test Dependencies -->
        <!-- AssertJ for fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>

        <!-- TestContainers for database testing (PostgreSQL) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.19.7</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.19.7</version>
            <scope>test</scope>
        </dependency>

        <!-- Hamcrest matchers for advanced assertions -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Faker for test data generation -->
        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>1.0.2</version>
            <scope>test</scope>
        </dependency>

        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.15.2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                The build's own name, written into the jar (owner, 2026-10-21: "trebamo uvesti verziju app
                da pise negde na settings ili gde god i da dizemo svaki put kad izmenimo da mozemo da
                pratimo").

                <p>The version is the commit, so it rises on every change by itself and two machines can
                be compared by reading it. `git.properties` goes into the classpath and
                `BuildInfoController` reads it; the app shows it on the Settings page.

                <p>**It is written by the build, not by a plugin that has to be downloaded.** The
                git-commit-id plugin is the usual way, and it is not here: its own dependency is not in
                the offline repository, so an offline build - the owner's local one - would fail before
                it started. One `sh` line does the same work with what every build already has.

                <p>Without git (a source archive, a machine with no repository) the file says
                "unknown" and the build still succeeds: a build that cannot say its version is still a
                build that works.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>write-build-info</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>mkdir -p "${project.build.outputDirectory}" &amp;&amp; { echo "git.commit.id.abbrev=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"; echo "git.branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"; echo "git.build.time=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > "${project.build.outputDirectory}/git.properties"; exit 0</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Spring Boot plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                **A test run must never open a browser on the owner's machine.**

                <p>{@code BrowserLauncher} is an {@code ApplicationRunner}, and {@code @SpringBootTest}
                runs the application runners. It has three guards against opening a browser in a test —
                the {@code test} profile, {@code application-test.properties} setting
                {@code app.open-browser=false}, and the property being honoured only when set — and
                <b>all three were defeated by the same thing</b>: the {@code test} profile is never
                activated. {@code application.properties} sets {@code spring.profiles.active=dev}, the
                dev profile points at the owner's PostgreSQL, and there is no surefire configuration
                to say otherwise. So the profile is {@code dev}, {@code application-test.properties} is
                never read, and the launcher ran with {@code matchIfMissing = true} — and on macOS
                {@code /usr/bin/open http://localhost:8080/login.html} opened <b>the owner's own
                browser</b>, once for every test run that booted a context.

                <p>The property is set here, as a system property, because it is the one thing that has
                to be true of every test run and does not depend on a profile, a properties file or a
                code path somebody has to remember. It changes nothing else: the datasource stays
                where it is, the clock stays where it is, and the owner's own start from the IDE still
                opens the browser — that is the {@code app.open-browser} default and it is not touched
                here.

                <p><b>What this cannot do.</b> A handful of tests are PostgreSQL-only - the ledger's
                `DISTINCT ON` query, the check constraints, the unique indexes the seeders trip over -
                and they are the ones that need a real PostgreSQL to talk to. A test that exercises
                PostgreSQL-only behaviour against H2 is a test that does not exercise it, and those
                tests say so in their own assertions.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- **The clock does not move, and no browser opens.**
                             The dev profile points at the owner's world and has the game clock's
                             scheduler ON, so a test run wrote into it and the matchday job persisted
                             real matches into it - measured: nine of them, from one test class's
                             context boot. A "green" test run moved the owner's season.

                             **The clock, and only the clock.** The world itself is not isolated,
                             and it cannot be: the suite is written against a populated world. Measured,
                             the service package alone is 623 errors against an empty database and
                             721 against H2, because the tests count the clubs, the players and the
                             fixtures of a real one. A test that cannot see the world cannot measure
                             it. So the world stays, and what stops is the **movement**: with the
                             scheduler off, a test run no longer advances the owner's season.
                             (The database `sokker_test` was created for the attempt and is left
                             there; it is not used.) -->
                        <game.clock.scheduler-enabled>false</game.clock.scheduler-enabled>
                        <app.open-browser>false</app.open-browser>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Lombok needs reflective access on Java 21 without the release flag -->
                    <compilerArgs>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.lang=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.lang.reflect=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.util=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.util.concurrent=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.util.concurrent.atomic=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.io=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.net=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.nio=ALL-UNNAMED</arg>
                        <arg>--add-opens</arg>
                        <arg>java.base/java.nio.file=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>