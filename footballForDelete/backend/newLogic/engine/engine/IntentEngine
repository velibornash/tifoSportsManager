package org.example.footballmanager.newLogic.engine;

import org.example.footballmanager.newLogic.model.*;

import java.util.*;

public final class IntentEngine {

    // Slobodna lopta — samo u susednom polju (jedna zona = ~18 jedinica)
    private static final double CHASE_BALL_RADIUS = 20.0;
    // Press — samo za opasnog napadača blizu gola
    private static final double PRESS_RADIUS = 12.0;
    private static final double DANGER_ZONE_X = 25.0; // blizu vlastitog gola

    private final Map<Long, Intent> intentMap = new HashMap<>();

    public void update(MatchState state, AwarenessEngine awareness) {
        for (PlayerSnapshot snap : state.playerSnapshots) {
            Intent current = intentMap.getOrDefault(snap.playerId(), Intent.RETURN_TO_SHAPE);
            Intent next = decideIntent(snap, state, awareness.get(snap.playerId()), current);
            intentMap.put(snap.playerId(), next);
        }
    }

    public Intent getIntent(long playerId) {
        return intentMap.getOrDefault(playerId, Intent.RETURN_TO_SHAPE);
    }

    /**
     * Taktičke pozicije (ZonePositionCalculator) su DEFAULT target.
     * Izuzeci:
     *  - GK_TRACK: golman prati loptu (ne taktika)
     *  - CARRY_BALL: carrier napreduje ka golu (blend taktike + napredovanje)
     *  - CHASE_BALL: slobodna lopta u blizini — ide ka lopti
     *  - PRESS: opasan napadač blizu gola — blend taktike i carrier-a
     *  - Sve ostalo (SUPPORT, MARK, RETURN_TO_SHAPE): koristi taktičku poziciju
     */
    public double[] getTarget(long playerId, PlayerSnapshot snap, MatchState state,
                              AwarenessEngine awareness, ZonePositionCalculator zones) {
        Intent intent = getIntent(playerId);
        String slotKey = state.playerSlotKeys.get(playerId);

        return switch (intent) {
            case RETURN_TO_SHAPE -> zones.getTarget(playerId, slotKey);
            case SUPPORT -> zones.getTarget(playerId, slotKey);
            case MARK -> zones.getTarget(playerId, slotKey);
            case CARRY_BALL -> carryBallTarget(snap, state, zones, playerId, slotKey);
            case PRESS -> blendWithCarrier(snap, state, zones, playerId, slotKey);
            case CHASE_BALL -> new double[]{state.ball.x(), state.ball.y()};
            case HOLD_POSITION -> new double[]{snap.x(), snap.y()};
            case GK_TRACK -> findGkTarget(snap, state);
        };
    }

    /**
     * Carrier — blend taktičke pozicije sa napredovanjem ka golu.
     * 60% ka golu, 40% taktika — carrier se pomera ka golu ali prati formaciju.
     */
    private double[] carryBallTarget(PlayerSnapshot snap, MatchState state,
                                      ZonePositionCalculator zones, long playerId, String slotKey) {
        double[] tactical = zones.getTarget(playerId, slotKey);
        boolean home = snap.teamSide().equals("HOME");
        double goalX = home ? 96.0 : 4.0;
        double goalY = 50.0;

        // 60% ka golu, 40% taktika — agresivno napredovanje
        double blend = 0.60;
        double targetX = tactical[0] + (goalX - tactical[0]) * blend;
        double targetY = tactical[1] + (goalY - tactical[1]) * blend * 0.3; // manje Y pomeranje

        return new double[]{targetX, targetY};
    }

    /**
     * Press — blend taktičke pozicije sa carrier pozicijom.
     * 70% taktika, 30% carrier — igrač se približava carrier-u ali ne napušta formaciju potpuno.
     */
    private double[] blendWithCarrier(PlayerSnapshot snap, MatchState state,
                                       ZonePositionCalculator zones, long playerId, String slotKey) {
        double[] tactical = zones.getTarget(playerId, slotKey);
        if (state.carrierId == null) return tactical;

        PlayerSnapshot carrier = state.snapshotById(state.carrierId);
        if (carrier == null) return tactical;

        double blend = 0.30; // 30% ka carrier-u, 70% taktika
        double targetX = tactical[0] + (carrier.x() - tactical[0]) * blend;
        double targetY = tactical[1] + (carrier.y() - tactical[1]) * blend;
        return new double[]{targetX, targetY};
    }

    private Intent decideIntent(PlayerSnapshot snap, MatchState state,
                                AwarenessEngine.PlayerAwareness aw, Intent current) {
        // Golman uvek prati loptu
        if (snap.position() == Position.GK) {
            return Intent.GK_TRACK;
        }

        // Ball carrier — napreduje ka golu
        if (aw.isBallCarrier()) {
            return Intent.CARRY_BALL;
        }

        // SLOBODNA LOPTA u susednom polju — ide ka lopti
        if (aw.ballFree() && aw.distToBall() < CHASE_BALL_RADIUS) {
            return Intent.CHASE_BALL;
        }

        // OPASAN NAPADAČ blizu gola — press (samo za defanzivce blizu vlastitog gola)
        if (state.carrierId != null && !state.carrierTeamSide.equals(snap.teamSide())) {
            PlayerSnapshot carrier = state.snapshotById(state.carrierId);
            if (carrier != null) {
                // Opasnost: carrier blizu našeg gola
                boolean home = snap.teamSide().equals("HOME");
                double carrierDistToOurGoal = home ? carrier.x() : (100.0 - carrier.x());
                boolean carrierDangerous = carrierDistToOurGoal < DANGER_ZONE_X;

                double distToCarrier = snap.distanceTo(carrier);
                if (carrierDangerous && distToCarrier < PRESS_RADIUS && isNearestDefender(snap, carrier, state)) {
                    return Intent.PRESS;
                }
            }
        }

        // Sve ostalo — RETURN_TO_SHAPE (koristi taktičke pozicije)
        return Intent.RETURN_TO_SHAPE;
    }

    private boolean isNearestDefender(PlayerSnapshot snap, PlayerSnapshot carrier, MatchState state) {
        double myDist = snap.distanceTo(carrier);
        for (PlayerSnapshot other : state.playerSnapshots) {
            if (other.teamSide().equals(snap.teamSide()) && other.playerId() != snap.playerId()) {
                if (other.position() == Position.GK) continue;
                double otherDist = other.distanceTo(carrier);
                if (otherDist < myDist) return false;
            }
        }
        return true;
    }

    private double[] findGkTarget(PlayerSnapshot snap, MatchState state) {
        boolean home = snap.teamSide().equals("HOME");
        double goalX = home ? 6.0 : 94.0;
        double goalY = 50.0;

        double ballX = state.ball.x();
        double ballY = state.ball.y();

        boolean carrierExists = state.carrierId != null;
        double distToBall = Math.hypot(snap.x() - ballX, snap.y() - ballY);

        if (!carrierExists && distToBall < 15.0) {
            return new double[]{ballX, ballY};
        }

        double targetY = goalY + (ballY - goalY) * 0.35;
        targetY = Math.max(MatchState.MIN_Y + 8, Math.min(MatchState.MAX_Y - 8, targetY));

        double targetX;
        if (home) {
            if (ballX > 70) {
                targetX = goalX + Math.min(10.0, (ballX - goalX) * 0.15);
            } else if (ballX < 30) {
                targetX = goalX + 2.0;
            } else {
                targetX = goalX + 3.0;
            }
            targetX = Math.max(goalX - 1.5, Math.min(goalX + 12.0, targetX));
        } else {
            if (ballX < 30) {
                targetX = goalX - Math.min(10.0, (goalX - ballX) * 0.15);
            } else if (ballX > 70) {
                targetX = goalX - 2.0;
            } else {
                targetX = goalX - 3.0;
            }
            targetX = Math.min(goalX + 1.5, Math.max(goalX - 12.0, targetX));
        }

        return new double[]{targetX, targetY};
    }

    public enum Intent {
        RETURN_TO_SHAPE,
        PRESS,
        CHASE_BALL,
        MARK,
        SUPPORT,
        CARRY_BALL,
        HOLD_POSITION,
        GK_TRACK
    }
}